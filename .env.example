# kma-weather-proxy 배포 후 나오는 프록시 URL.
# Cloudflare Workers(workers/kma-weather-proxy) 또는 Vercel(vercel-proxy/kma-weather-proxy) 중
# 실제로 배포한 쪽 URL을 넣으면 됩니다 — 프론트엔드 코드는 어느 쪽이든 동일하게 동작합니다.
# 서비스키가 아니라 공개 프록시 주소라 커밋해도 안전합니다 — .env로 복사해 채워주세요.
#
# Vercel 예: VITE_WEATHER_PROXY_URL=https://kma-weather-proxy.vercel.app
# Cloudflare 예: VITE_WEATHER_PROXY_URL=https://jeju-kma-weather-proxy.<your-subdomain>.workers.dev
VITE_WEATHER_PROXY_URL=
